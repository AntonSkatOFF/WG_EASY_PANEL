<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Вход - WG Panel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <script async src="https://telegram.org/js/telegram-widget.js?22" 
          data-telegram-login="<%= botUsername %>" 
          data-size="large" 
          data-onauth="onTelegramAuth(user)" 
          data-request-access="write"></script>
</head>
<body>
  <div class="login-container">
    <div class="login-card">
      <div class="text-center mb-4">
        <svg class="wg-logo" viewBox="0 0 100 100" width="80" height="80">
          <path fill="#4ade80" d="M50 5L15 25v50l35 20 35-20V25L50 5zm0 9L78 30v40L50 86 22 70V30L50 14z"/>
          <path fill="#4ade80" d="M50 25L30 37v26l20 12 20-12V37L50 25z"/>
        </svg>
        <h1 class="mt-3">WG Panel</h1>
        <p class="text-muted">WireGuard Easy Management</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <div class="text-center">
        <p class="mb-3">Войдите через Telegram для продолжения</p>
        <div id="telegram-login"></div>
      </div>

      <hr class="my-4">
      
      <p class="text-muted small text-center">
        Для входа необходимо быть авторизованным в системе.<br>
        Если вы новый пользователь, создайте заявку после входа.
      </p>
    </div>
  </div>

  <script>
    function onTelegramAuth(user) {
      // Send user data to backend for authentication
      fetch('/auth/telegram', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(user)
      })
      .then(response => {
        if (response.ok) {
          window.location.href = '/';
        } else {
          alert('Ошибка аутентификации');
        }
      })
      .catch(error => {
        console.error('Error:', error);
        alert('Ошибка соединения');
      });
    }
  </script>
</body>
</html>
