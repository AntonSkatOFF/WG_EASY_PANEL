<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Заявка на доступ - WG Panel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <div class="dashboard-container">
    <nav class="navbar navbar-dark">
      <div class="container-fluid">
        <span class="navbar-brand">WG Panel</span>
        <a href="/logout" class="btn btn-outline-light btn-sm">Выйти</a>
      </div>
    </nav>

    <div class="container mt-4">
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="card">
            <div class="card-header">
              <h5><%= existingRequest ? 'Ваша заявка на рассмотрении' : 'Создать заявку на доступ' %></h5>
            </div>
            <div class="card-body">
              <% if (existingRequest) { %>
                <div class="text-center">
                  <div class="spinner-border text-success mb-3" role="status"></div>
                  <p class="lead">Ваша заявка отправлена администратору</p>
                  <p class="text-muted">После одобрения вы получите доступ к личному кабинету.</p>
                  <p class="small text-muted">Вы также получите уведомление в Telegram.</p>
                </div>
              <% } else { %>
                <% if (locals.error) { %>
                  <div class="alert alert-danger"><%= error %></div>
                <% } %>
                
                <form method="POST" action="/request">
                  <div class="mb-3">
                    <label for="clientName" class="form-label">Имя устройства</label>
                    <input type="text" class="form-control" id="clientName" name="clientName" 
                           placeholder="Например: iphone, laptop, work-pc" required>
                    <div class="form-text">Укажите имя для вашего WireGuard конфига</div>
                  </div>
                  <button type="submit" class="btn btn-success w-100">Отправить заявку</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
