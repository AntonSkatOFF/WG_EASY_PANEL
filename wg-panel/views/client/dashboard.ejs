<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Личный кабинет - WG Panel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <div class="dashboard-container">
    <nav class="navbar navbar-dark">
      <div class="container-fluid">
        <span class="navbar-brand">👤 Личный кабинет</span>
        <a href="/logout" class="btn btn-outline-light btn-sm">Выйти</a>
      </div>
    </nav>

    <div class="container mt-4">
      <% if (locals.error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <div class="row justify-content-center">
        <div class="col-lg-8">
          <!-- Client Info Card -->
          <div class="card mb-4">
            <div class="card-header">
              <h5>Информация о подключении</h5>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <p><strong>Имя устройства:</strong> <%= client.name %></p>
                  <p><strong>ID клиента:</strong> <%= client.id %></p>
                </div>
                <div class="col-md-6">
                  <p><strong>Статус:</strong> 
                    <span class="badge <%= client.enabled ? 'bg-success' : 'bg-secondary' %>">
                      <%= client.enabled ? 'Активен' : 'Отключен' %>
                    </span>
                  </p>
                  <p><strong>Создан:</strong> <%= new Date(client.createdAt).toLocaleDateString('ru-RU') %></p>
                </div>
              </div>
              <hr>
              <p><strong>Последнее подключение:</strong> 
                <%= client.latestHandshakeAt ? new Date(client.latestHandshakeAt).toLocaleString('ru-RU') : 'Не подключался' %>
              </p>
            </div>
          </div>

          <!-- QR Code and Config -->
          <div class="row">
            <div class="col-md-6 mb-4">
              <div class="card h-100">
                <div class="card-header">
                  <h5>📱 QR-код для мобильного</h5>
                </div>
                <div class="card-body text-center">
                  <% if (qrCode) { %>
                    <img src="data:image/svg+xml;base64,<%= qrCode %>" alt="QR Code" class="qr-code img-fluid" />
                    <p class="small text-muted mt-2">Отсканируйте в приложении WireGuard</p>
                  <% } else { %>
                    <p class="text-muted">QR-код недоступен</p>
                  <% } %>
                </div>
              </div>
            </div>

            <div class="col-md-6 mb-4">
              <div class="card h-100">
                <div class="card-header">
                  <h5>📄 Конфигурация</h5>
                </div>
                <div class="card-body text-center">
                  <p class="text-muted mb-3">Скачайте .conf файл для импорта в WireGuard</p>
                  <a href="/client/config/<%= client.id %>" class="btn btn-success btn-lg">
                    ⬇️ Скачать конфиг
                  </a>
                  <hr>
                  <p class="small text-muted">
                    Для ПК: импортируйте файл в клиент WireGuard<br>
                    Для мобильных: используйте QR-код выше
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Traffic Stats (if available) -->
          <% if (typeof client.transferRx !== 'undefined' || typeof client.transferTx !== 'undefined') { %>
          <div class="card">
            <div class="card-header">
              <h5>📊 Статистика трафика</h5>
            </div>
            <div class="card-body">
              <div class="row text-center">
                <div class="col-6">
                  <h4 class="text-success">⬇️ <%= (client.transferRx / 1073741824).toFixed(2) %> GB</h4>
                  <p class="text-muted">Получено</p>
                </div>
                <div class="col-6">
                  <h4 class="text-info">⬆️ <%= (client.transferTx / 1073741824).toFixed(2) %> GB</h4>
                  <p class="text-muted">Отправлено</p>
                </div>
              </div>
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
